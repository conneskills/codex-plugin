{
  "mcpServers": {
    "conneskills-kbs": {
      "type": "http",
      "url": "https://app.conneskills.com/api/mcp/kbs",
      "scopes": ["connectors:read", "kb:query"]
    },
    "conneskills-code": {
      "type": "http",
      "url": "https://app.conneskills.com/api/mcp/brain/code",
      "scopes": ["code:read", "code:index", "code:episodes"]
    },
    "conneskills-memory": {
      "type": "http",
      "url": "https://app.conneskills.com/api/mcp/brain/memory",
      "scopes": [
        "memory:read",
        "memory:write",
        "memory:consolidate",
        "memory:intentions"
      ]
    },
    "conneskills-planning": {
      "type": "http",
      "url": "https://app.conneskills.com/api/mcp/brain/planning",
      "scopes": [
        "planning:read",
        "planning:write",
        "planning:governance"
      ]
    }
  }
}
